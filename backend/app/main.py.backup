from fastapi import (
    FastAPI,
    HTTPException,
    UploadFile,
    File,
    Form,
)
from app.services.chatbot_service import answer_chat
from app.services.llm_chat_service import generate_hr_answer
from app.services.comparison_service import compare_candidates as build_comparison
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from app.services.candidate_service import get_candidate_by_id
from app.services.resume_parser_service import extract_resume_text
from app.services.prediction_service import predict_candidate
from app.services.upload_explainability_service import (
    get_upload_explanations,
)
from pathlib import Path
from app.services.explainability_service import (
    get_shap_global,
    get_shap_structured,
    get_shap_candidate,
    get_lime_candidate,
)

from app.services.resume_intelligence_service import (
    build_resume_intelligence
)
app = FastAPI(
    title="FairHire AI V2 API",
    description="AI-powered explainable resume screening and candidate intelligence API",
    version="2.0.0",
)

# Allow frontend applications to communicate with the API
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)
class CandidatePredictionRequest(BaseModel):
    resume_text: str
    job_description: str
    skills: str
    required_skills: str = ""
    experience_years: float = 0
    required_experience: float = 0
    job_role: str
    previous_role: str = ""
    projects: str = ""
class CandidateCompareRequest(BaseModel):
    candidate_ids: list[str]
class ChatRequest(BaseModel):
    message: str
@app.post("/api/predict")
def predict_resume(request: CandidatePredictionRequest):
    result = predict_candidate(
        request.model_dump()
    )

    return {
        "prediction": result["prediction"],
        "decision_score": result["decision_score"],
    }
@app.get("/api/candidate/{candidate_id}")
def get_candidate(candidate_id: str):
    candidate = get_candidate_by_id(candidate_id)

    if candidate is None:
        raise HTTPException(
            status_code=404,
            detail=f"Candidate {candidate_id} not found",
        )

    return candidate


@app.post("/api/compare")
def compare_candidates(request: CandidateCompareRequest):
    candidate_ids = request.candidate_ids

    if len(candidate_ids) < 2:
        raise HTTPException(
            status_code=400,
            detail="At least 2 candidates are required for comparison.",
        )

    if len(candidate_ids) > 10:
        raise HTTPException(
            status_code=400,
            detail="A maximum of 10 candidates can be compared at once.",
        )

    if any(not candidate_id.strip() for candidate_id in candidate_ids):
        raise HTTPException(
            status_code=400,
            detail="Candidate IDs cannot be empty.",
        )

    if len(set(candidate_ids)) != len(candidate_ids):
        raise HTTPException(
            status_code=400,
            detail="Duplicate candidate IDs are not allowed.",
        )

    candidates = []

    for candidate_id in candidate_ids:
        candidate = get_candidate_by_id(candidate_id.strip())

        if candidate is None:
            raise HTTPException(
                status_code=404,
                detail=f"Candidate {candidate_id} not found.",
            )

        candidates.append(candidate)

    return build_comparison(candidates)




@app.get("/api/explain/shap/global")
def shap_global():
    return {
        "explanation_type": "SHAP",
        "scope": "global",
        "data": get_shap_global(),
    }


@app.get("/api/explain/shap/structured")
def shap_structured():
    return {
        "explanation_type": "SHAP",
        "scope": "structured_features",
        "data": get_shap_structured(),
    }


@app.get("/api/explain/shap/{candidate_id}")
def shap_candidate(candidate_id: str):

    explanation = get_shap_candidate(candidate_id)

    if not explanation:
        raise HTTPException(
            status_code=404,
            detail=f"SHAP explanation not found for Candidate {candidate_id}",
        )

    return {
        "candidate_id": candidate_id,
        "explanation_type": "SHAP",
        "data": explanation,
    }
@app.get("/api/explain/lime/{candidate_id}")
def lime_candidate(candidate_id: str):

    explanation = get_lime_candidate(candidate_id)

    if not explanation:
        raise HTTPException(
            status_code=404,
            detail=f"LIME explanation not found for Candidate {candidate_id}",
        )

    return {
        "candidate_id": candidate_id,
        "explanation_type": "LIME",
        "data": explanation,
    }

@app.get("/")
def root():
    return {
        "message": "FairHire AI V2 API is running",
        "version": "2.0.0",
        "status": "online",
    }


@app.get("/api/health")
def health_check():
    return {
        "status": "healthy",
        "service": "FairHire AI V2",
        "model": "SVM + TF-IDF + Structured Features",
    }
@app.post("/api/upload")
async def upload_resume(file: UploadFile = File(...)):
    if not file.filename:
        raise HTTPException(
            status_code=400,
            detail="No filename was provided."
        )

    filename = file.filename

    allowed_extensions = {".pdf", ".docx"}

    from pathlib import Path

    extension = Path(filename).suffix.lower()

    if extension not in allowed_extensions:
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type. Please upload a PDF or DOCX resume."
        )

    try:
        file_bytes = await file.read()

        text = extract_resume_text(
            filename=filename,
            file_bytes=file_bytes
        )

        return {
            "status": "success",
            "filename": filename,
            "content_type": file.content_type,
            "character_count": len(text),
            "text": text,
        }

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc)
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Resume processing failed: {str(exc)}"
        )
@app.post("/api/upload/analyze")
async def analyze_uploaded_resume(
    file: UploadFile = File(...)
):
    if not file.filename:
        raise HTTPException(
            status_code=400,
            detail="No filename was provided."
        )

    from pathlib import Path

    extension = Path(file.filename).suffix.lower()

    if extension not in {".pdf", ".docx"}:
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type. Please upload a PDF or DOCX resume."
        )

    try:
        file_bytes = await file.read()

        resume_text = extract_resume_text(
            filename=file.filename,
            file_bytes=file_bytes
        )

        intelligence = build_resume_intelligence(
            resume_text
        )

        return {
            "status": "success",
            "filename": file.filename,
            "intelligence": intelligence
        }

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc)
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Resume analysis failed: {str(exc)}"
        )
@app.post("/api/upload/predict")
async def predict_uploaded_resume(
    file: UploadFile = File(...),
    job_role: str = Form(...),
    job_description: str = Form(...),
    required_skills: str = Form(""),
    required_experience: float = Form(0),
):
    if not file.filename:
        raise HTTPException(
            status_code=400,
            detail="No filename was provided."
        )

    from pathlib import Path

    extension = Path(file.filename).suffix.lower()

    if extension not in {".pdf", ".docx"}:
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type. Please upload a PDF or DOCX resume."
        )

    if not job_role.strip():
        raise HTTPException(
            status_code=400,
            detail="Job role is required."
        )

    if not job_description.strip():
        raise HTTPException(
            status_code=400,
            detail="Job description is required."
        )

    try:
        file_bytes = await file.read()

        resume_text = extract_resume_text(
            filename=file.filename,
            file_bytes=file_bytes
        )

        intelligence = build_resume_intelligence(
            resume_text
        )

        candidate_data = {
            "resume_text": resume_text,
            "job_description": job_description,
            "skills": ", ".join(
                intelligence["skills"]
            ),
            "required_skills": required_skills,
            "experience_years": intelligence[
                "experience_years"
            ],
            "required_experience": required_experience,
            "job_role": job_role,
            "previous_role": intelligence[
                "previous_role"
            ],
            "projects": " ".join(
                intelligence["projects"]
            ),
        }

        prediction_result = predict_candidate(
            candidate_data
        )
        explanations = get_upload_explanations(
    candidate_data
)

        return {
            "status": "success",
            "filename": file.filename,
            "candidate": {
                "candidate_name": intelligence[
                    "candidate_name"
                ],
                "skills": intelligence["skills"],
                "experience_years": intelligence[
                    "experience_years"
                ],
                "previous_role": intelligence[
                    "previous_role"
                ],
                "projects": intelligence["projects"],
            },
            "job": {
                "job_role": job_role,
                "required_skills": required_skills,
                "required_experience": required_experience,
            },
            "prediction": {
                "label": prediction_result[
                    "prediction"
                ],
                "decision_score": prediction_result[
                    "decision_score"
                ],
            },
           "explanations": {
    "available": True,
    "shap": explanations["shap"],
    "lime": explanations["lime"],
},
        }

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc)
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Resume prediction failed: {str(exc)}"
        )
@app.post("/api/chat")
def chat_with_hr_assistant(request: ChatRequest):
    message = request.message.strip()

    if not message:
        raise HTTPException(
            status_code=400,
            detail="Message cannot be empty.",
        )

    if len(message) > 1000:
        raise HTTPException(
            status_code=400,
            detail="Message cannot exceed 1000 characters.",
        )

    return answer_chat(message)



@app.post("/api/compare/uploads")
async def compare_uploaded_resumes(
    resume_a: UploadFile = File(...),
    resume_b: UploadFile = File(...),
    job_role: str = Form(...),
    job_description: str = Form(...),
    required_skills: str = Form(""),
    required_experience: float = Form(0),
):
    """
    Compare two newly uploaded resumes.
    Does not look up candidates in the saved candidate dataset.
    """

    if not job_role.strip():
        raise HTTPException(
            status_code=400,
            detail="Job role is required.",
        )

    if not job_description.strip():
        raise HTTPException(
            status_code=400,
            detail="Job description is required.",
        )

    allowed_extensions = {".pdf", ".docx"}

    async def analyze_upload(upload: UploadFile, label: str):
        if not upload.filename:
            raise HTTPException(
                status_code=400,
                detail=f"{label}: filename is missing.",
            )

        extension = Path(upload.filename).suffix.lower()

        if extension not in allowed_extensions:
            raise HTTPException(
                status_code=400,
                detail=f"{label}: upload a PDF or DOCX resume.",
            )

        file_bytes = await upload.read()

        if not file_bytes:
            raise HTTPException(
                status_code=400,
                detail=f"{label}: uploaded file is empty.",
            )

        resume_text = extract_resume_text(
            filename=upload.filename,
            file_bytes=file_bytes,
        )

        if not resume_text or not resume_text.strip():
            raise HTTPException(
                status_code=400,
                detail=(
                    f"{label}: no readable text was extracted. "
                    "If this is a scanned PDF, OCR may be required."
                ),
            )

        intelligence = build_resume_intelligence(resume_text)

        skills = intelligence.get("skills") or []
        if isinstance(skills, str):
            skills = [
                skill.strip()
                for skill in skills.split(",")
                if skill.strip()
            ]

        candidate_data = {
            "resume_text": resume_text,
            "job_description": job_description.strip(),
            "skills": ", ".join(skills),
            "required_skills": required_skills.strip(),
            "experience_years": float(
                intelligence.get("experience_years") or 0
            ),
            "required_experience": required_experience,
            "job_role": job_role.strip(),
            "previous_role": intelligence.get("previous_role") or "",
            "projects": " ".join(
                intelligence.get("projects") or []
            ) if isinstance(
                intelligence.get("projects") or [], list
            ) else str(intelligence.get("projects") or ""),
        }

        prediction = predict_candidate(candidate_data)
        explanations = get_upload_explanations(candidate_data)

        resume_skills = {
            str(skill).strip().casefold()
            for skill in skills
            if str(skill).strip()
        }
        required = {
            skill.strip().casefold()
            for skill in required_skills.split(",")
            if skill.strip()
        }

        matched = sorted(resume_skills & required)
        missing = sorted(required - resume_skills)

        return {
            "label": label,
            "filename": upload.filename,
            "candidate": {
                "candidate_name": intelligence.get("candidate_name"),
                "skills": skills,
                "experience_years": candidate_data["experience_years"],
                "previous_role": candidate_data["previous_role"],
                "projects": intelligence.get("projects") or [],
            },
            "evaluation": {
                "prediction": prediction.get("prediction"),
                "decision_score": prediction.get("decision_score"),
                "matched_skills": matched,
                "missing_skills": missing,
                "matched_skill_count": len(matched),
                "required_skill_count": len(required),
                "experience_requirement_met": (
                    candidate_data["experience_years"]
                    >= required_experience
                ),
            },
            "explanations": {
                "available": bool(explanations),
                "shap": explanations.get("shap"),
                "lime": explanations.get("lime"),
            },
        }

    try:
        result_a = await analyze_upload(resume_a, "Resume A")
        result_b = await analyze_upload(resume_b, "Resume B")

        score_a = result_a["evaluation"].get("decision_score")
        score_b = result_b["evaluation"].get("decision_score")

        # The decision score is a model output, not a hiring probability.
        if score_a is None or score_b is None:
            higher_score = None
        elif score_a > score_b:
            higher_score = "Resume A"
        elif score_b > score_a:
            higher_score = "Resume B"
        else:
            higher_score = "Tie"

        return {
            "status": "success",
            "source": "uploaded_resumes_only",
            "job": {
                "job_role": job_role.strip(),
                "job_description": job_description.strip(),
                "required_skills": [
                    skill.strip()
                    for skill in required_skills.split(",")
                    if skill.strip()
                ],
                "required_experience": required_experience,
            },
            "comparison": {
                "resume_a": result_a,
                "resume_b": result_b,
                "higher_model_decision_score": higher_score,
                "score_note": (
                    "Model decision scores are not probabilities of "
                    "employment success and should not be used as the "
                    "sole basis for a hiring decision."
                ),
            },
        }

    except HTTPException:
        raise
    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=f"Could not evaluate the uploaded resumes: {exc}",
        )
    except Exception:
        logger.exception("Uploaded resume comparison failed")
        raise HTTPException(
            status_code=500,
            detail="Resume comparison failed. Check the backend terminal.",
        )